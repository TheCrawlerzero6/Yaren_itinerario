<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yaren_master</name>
  <version>1.0.0</version>
  <description>
    Paquete de control y simulacion del robot Yaren. Contiene el mundo de
    trabajo, la configuracion del gestor de controladores, los ficheros de
    arranque y los programas de control en Python.
  </description>
  <maintainer email="alanbajag@gmail.com">Equipo Yaren</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Descripcion del robot: URDF, mallas y configuracion de RViz. -->
  <exec_depend>yaren_description</exec_depend>

  <!-- Lectura del catalogo de posturas. -->
  <exec_depend>python3-yaml</exec_depend>

  <!-- Cliente de ROS 2 para Python y tipos de mensaje usados por los nodos. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>

  <!-- Gestor de controladores y controladores utilizados. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <!-- Simulador, insercion de modelos y puente de topicos. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- Publicacion del arbol TF y visualizacion. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Utilidades del sistema de arranque usadas por los ficheros launch. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
